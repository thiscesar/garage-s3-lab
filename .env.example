# Modelo do .env do laboratório. Não edite este arquivo com valores reais:
# `make env` copia para .env e preenche o que estiver vazio.

# --- Segredos do cluster (gerados por `make env`, 32 bytes em hexadecimal) ---
RPC_SECRET=
ADMIN_TOKEN=
METRICS_TOKEN=

# --- Faixas das redes. Padrão = IPs do roteiro (172.30.0.x e 172.31.0.x).
# Troque só se a faixa colidir com outra rede do host; `make env` avisa quando colide.
# Os finais são fixos: nós .21, .22, .23; cliente .100.
REDE_INTERNA_PREFIXO=172.30.0
REDE_CLIENTES_PREFIXO=172.31.0

# --- Usuário dos contêineres Garage, para dados/ ficar com o seu usuário (preenchidos por `make env`) ---
UID=
GID=

# --- Credenciais S3 da chave sd-key (gravadas por scripts/iniciar.sh) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
